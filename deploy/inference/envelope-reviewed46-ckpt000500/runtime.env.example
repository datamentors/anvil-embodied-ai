# Copy to runtime.env and adapt these host-local values. runtime.env is ignored.
MODEL_PATH=/absolute/path/to/checkpoints/000500
HF_CACHE=/absolute/path/to/huggingface-cache

# Both machines must use the same ROS domain and mirrored static peers.
ROS_DOMAIN_ID=204
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
DDS_IFACE=replace-with-inference-interface
DDS_LOCAL_IP=replace-with-inference-lan-ip
DDS_PEER_IP=replace-with-robot-lan-ip

CONTROL_FREQ=30.0
INFERENCE_CPU_THREADS=4
IMAGE_TAG=envelope-reviewed46-ckpt000500-shadow-safety-v2
LEROBOT_VERSION=0.5.1
LEROBOT_EXTRAS=pi
